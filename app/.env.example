# ==============================================================================
# VoxEye Runtime & Voiceover Configuration (Copy to app/.env)
# ==============================================================================

# 1. Fal.ai / ElevenLabs v3 Voiceover
FAL_API_KEY=your_fal_api_key_here
EYES_TTS_PROVIDER=fal
FAL_TTS_MODEL=fal-ai/elevenlabs/tts/eleven-v3
FAL_TTS_VOICE=Rachel

# 2. Gemini API Configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_VOICE=Kore
