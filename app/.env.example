# Copy to .env and fill in. Never commit .env.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_HARD_MODEL=gemini-3.8-flash
GEMINI_LIVE_MODEL=gemini-3.8-live
GEMINI_LIVE_FALLBACK_MODEL=gemini-2.5-flash-native-audio-latest
GEMINI_VOICE=Kore

GEMINI_TTS_MODEL=gemini-3.8-flash-lite-tts

# Depth emergency stop (all optional)
EYES_DEPTH_STOP_M=0.9              # stop when the camera-center depth is at/below this many metres
EYES_DEPTH_STOP_URGENT_M=0.6       # threshold in "urgent only" alert mode
EYES_DEPTH_STOP_COOLDOWN_S=4       # minimum gap between two stops
EYES_DEPTH_STOP_GUIDE_TIMEOUT_S=8  # give up on the model's "what to do" and speak a fallback after this
EYES_GUIDE_SPEECH_RATE=1.35        # pitch-preserving speed-up of the stop guidance (1.0 = normal)
# GEMINI_DEPTH_PROBE_MODEL=gemini-3.5-flash-lite   # center-crop metric anchor used during hold scans

# Places / tour guide (optional). Google Maps Platform key with Places API (New), Geocoding API and Routes API
# enabled. Without it the free OpenStreetMap fallback (Nominatim + Overpass) is used automatically.
GOOGLE_MAPS_API_KEY=
# EYES_GEO_PROVIDER=auto      # auto | google | osm

# Many connections at once (optional)
EYES_MAX_CONNECTIONS=10
EYES_MAX_PARALLEL_CALLS=6

# fal API (server-side only; get a key at https://fal.ai/dashboard/keys)
FAL_API_KEY=
# EYES_TTS_PROVIDER=gemini   # set to "fal" to speak alerts with ElevenLabs v3 through fal
# FAL_TTS_VOICE=Rachel
