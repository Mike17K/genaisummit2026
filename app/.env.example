# Copy to .env and fill in. Never commit .env.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_HARD_MODEL=gemini-3.8-flash
GEMINI_LIVE_MODEL=gemini-2.5-flash-native-audio-latest
GEMINI_VOICE=Kore

# Proactive safety watcher (all optional)
GEMINI_WATCH_MODEL=gemini-3.5-flash-lite
GEMINI_TTS_MODEL=gemini-3.8-flash-lite-tts
EYES_WATCH_S=2.0
EYES_ALERT_MIN_CONF=0.75
EYES_ALERT_COOLDOWN_S=6
EYES_ALERT_DEDUPE_S=25
EYES_ALERT_MAX_PER_MIN=6

# Many connections at once (optional)
EYES_MAX_CONNECTIONS=10
EYES_MAX_PARALLEL_CALLS=6

# Adaptive attention (optional)
EYES_FPS_NORMAL=1
EYES_FPS_ELEVATED=2.5
EYES_FPS_HIGH=4
EYES_LOOK_ELEVATED_S=1.2
EYES_LOOK_HIGH_S=0.8
EYES_ATTENTION_MAX_S=30
EYES_ATTENTION_COOLDOWN_S=12
